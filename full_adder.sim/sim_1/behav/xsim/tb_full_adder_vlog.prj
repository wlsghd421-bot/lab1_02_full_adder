# compile verilog/system verilog design source files
verilog xil_defaultlib  --include "../../../../../../../AMDDesignTools/2026.1/Vivado/data/rsb/busdef" \
"../../../../src/full_adder.v" \
"../../../../src/half_adder.v" \

sv xil_defaultlib  --include "../../../../../../../AMDDesignTools/2026.1/Vivado/data/rsb/busdef" \
"../../../../sim/tb_full_adder.sv" \

# compile glbl module
verilog xil_defaultlib "glbl.v"

# Do not sort compile order
nosort
